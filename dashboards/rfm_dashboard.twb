    <worksheet name='RFM - segment distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#499894' fontsize='14'>CUSTOMER DISTRIBUTION BY RFM SEGMENT</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rfm_customer_segmentation' name='federated.1u4if6a1y9ozz51g54qpq0sfnp5q' />
          </datasources>
          <datasource-dependencies datasource='federated.1u4if6a1y9ozz51g54qpq0sfnp5q'>
            <column caption='Segment explanation' datatype='string' name='[Calculation_4224289291464704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Segment]&#10;&#10;WHEN &quot;Champions&quot; THEN&#10;&quot;Recent, frequent &amp; high-value customers&quot;&#10;&#10;WHEN &quot;Loyal Customers&quot; THEN&#10;&quot;Consistent customers with strong engagement&quot;&#10;&#10;WHEN &quot;Potential Loyalists&quot; THEN&#10;&quot;Recent customers with growing engagement&quot;&#10;&#10;WHEN &quot;New Customers&quot; THEN&#10;&quot;Recently acquired with limited purchase history&quot;&#10;&#10;WHEN &quot;Promising&quot; THEN&#10;&quot;Recent customers with early potential&quot;&#10;&#10;WHEN &quot;Need Attention&quot; THEN&#10;&quot;Moderate activity showing signs of decline&quot;&#10;&#10;WHEN &quot;About to Sleep&quot; THEN&#10;&quot;Below-average engagement and becoming inactive&quot;&#10;&#10;WHEN &quot;At Risk&quot; THEN&#10;&quot;Previously active customers now disengaging&quot;&#10;&#10;WHEN &quot;Can&apos;t Loose&quot; THEN&#10;&quot;High-value customers at serious churn risk&quot;&#10;&#10;WHEN &quot;Hibernating&quot; THEN&#10;&quot;Long-inactive, low-engagement customers&quot;&#10;&#10;END' />
            </column>
            <column datatype='real' name='[Customer ID]' role='measure' type='quantitative' />
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4224289291464704]' derivation='Attribute' name='[attr:Calculation_4224289291464704:nk]' pivot='key' type='nominal' />
            <column-instance column='[Customer ID]' derivation='CountD' name='[ctd:Customer ID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Segment]' derivation='None' name='[none:Segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[Customer ID]' derivation='CountD' name='[pcto:ctd:Customer ID:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
          </datasource-dependencies>
          <manual-sort column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Segment:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Champions&quot;</bucket>
              <bucket>&quot;Loyal Customers&quot;</bucket>
              <bucket>&quot;Potential Loyalists&quot;</bucket>
              <bucket>&quot;New Customers&quot;</bucket>
              <bucket>&quot;Promising&quot;</bucket>
              <bucket>&quot;Need Attention&quot;</bucket>
              <bucket>&quot;About to Sleep&quot;</bucket>
              <bucket>&quot;At Risk&quot;</bucket>
              <bucket>&quot;Can&apos;t Loose&quot;</bucket>
              <bucket>&quot;Hibernating&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[ctd:Customer ID:qk]' scope='cols' value='Number of Customers' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[pcto:ctd:Customer ID:qk]' value='p0.0%' />
          </style-rule>
        </style>
