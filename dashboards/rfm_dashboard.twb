    <worksheet name='RFM - Segment Insight'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#499894' fontsize='14'>RFM SEGMENT INSIGHT</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rfm_customer_segmentation' name='federated.1u4if6a1y9ozz51g54qpq0sfnp5q' />
          </datasources>
          <datasource-dependencies datasource='federated.1u4if6a1y9ozz51g54qpq0sfnp5q'>
            <column caption='Segment Insight' datatype='string' name='[Calculation_4224289306980355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Segment]&#10;&#10;WHEN &quot;Champions&quot; THEN&#10;&quot;Your best customers — recent, frequent, and high-value purchasers.&quot;&#10;&#10;WHEN &quot;Loyal Customers&quot; THEN&#10;&quot;Consistent repeat customers with strong frequency and spending.&quot;&#10;&#10;WHEN &quot;Potential Loyalists&quot; THEN&#10;&quot;Recent customers showing strong potential to become loyal customers.&quot;&#10;&#10;WHEN &quot;New Customers&quot; THEN&#10;&quot;Recently acquired customers who are still early in their relationship.&quot;&#10;&#10;WHEN &quot;Promising&quot; THEN&#10;&quot;Recent customers with potential to increase engagement and value.&quot;&#10;&#10;WHEN &quot;Need Attention&quot; THEN&#10;&quot;Previously engaged customers whose activity is beginning to decline.&quot;&#10;&#10;WHEN &quot;About to Sleep&quot; THEN&#10;&quot;Customers becoming inactive and at increasing risk of disengagement.&quot;&#10;&#10;WHEN &quot;At Risk&quot; THEN&#10;&quot;Previously valuable customers who have not purchased recently.&quot;&#10;&#10;WHEN &quot;Can&apos;t Loose&quot; THEN&#10;&quot;High-value, frequent customers at serious risk of churn.&quot;&#10;&#10;WHEN &quot;Hibernating&quot; THEN&#10;&quot;Long-inactive customers with low recent engagement.&quot;&#10;&#10;END' />
            </column>
            <column caption='% of Total Customers' datatype='real' default-format='p0.0%' name='[Calculation_4224289309868036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Customer ID])&#10;/&#10;SUM({ FIXED : COUNTD([Customer ID]) })' />
            </column>
            <column caption='Recommended Action' datatype='string' name='[Calculation_4224289312370693]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Segment]&#10;&#10;WHEN &quot;Champions&quot; THEN&#10;&quot;Reward loyalty, offer exclusive benefits, and encourage referrals.&quot;&#10;&#10;WHEN &quot;Loyal Customers&quot; THEN&#10;&quot;Strengthen retention with loyalty rewards and personalized offers.&quot;&#10;&#10;WHEN &quot;Potential Loyalists&quot; THEN&#10;&quot;Nurture engagement with targeted offers and cross-sell opportunities.&quot;&#10;&#10;WHEN &quot;New Customers&quot; THEN&#10;&quot;Build early engagement with onboarding and second-purchase incentives.&quot;&#10;&#10;WHEN &quot;Promising&quot; THEN&#10;&quot;Encourage repeat purchases with relevant recommendations and offers.&quot;&#10;&#10;WHEN &quot;Need Attention&quot; THEN&#10;&quot;Re-engage with personalized promotions before activity declines further.&quot;&#10;&#10;WHEN &quot;About to Sleep&quot; THEN&#10;&quot;Use timely reactivation campaigns and limited-time incentives.&quot;&#10;&#10;WHEN &quot;At Risk&quot; THEN&#10;&quot;Launch targeted win-back campaigns based on past purchase behavior.&quot;&#10;&#10;WHEN &quot;Can&apos;t Loose&quot; THEN&#10;&quot;Prioritize immediate retention with personalized high-value incentives.&quot;&#10;&#10;WHEN &quot;Hibernating&quot; THEN&#10;&quot;Use low-cost reactivation campaigns or deprioritize if response remains low.&quot;&#10;&#10;END' />
            </column>
            <column datatype='real' name='[Customer ID]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Frequency]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c&quot;£&quot;#,##0.00;-&quot;£&quot;#,##0.00' name='[Monetary]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Recency]' role='measure' type='quantitative' />
            <column caption='Segment (rfm transaction dashboard.csv)' datatype='string' name='[Segment (rfm_transaction_dashboard.csv)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
            <column-instance column='[Frequency]' derivation='Avg' name='[avg:Frequency:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Monetary]' derivation='Avg' name='[avg:Monetary:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Recency]' derivation='Avg' name='[avg:Recency:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Customer ID]' derivation='CountD' name='[ctd:Customer ID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4224289306980355]' derivation='None' name='[none:Calculation_4224289306980355:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4224289312370693]' derivation='None' name='[none:Calculation_4224289312370693:nk]' pivot='key' type='nominal' />
            <column-instance column='[Segment (rfm_transaction_dashboard.csv)]' derivation='None' name='[none:Segment (rfm_transaction_dashboard.csv):nk]' pivot='key' type='nominal' />
            <column-instance column='[Segment]' derivation='None' name='[none:Segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4224289309868036]' derivation='User' name='[usr:Calculation_4224289309868036:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Segment (rfm_transaction_dashboard.csv):nk]' filter-group='3'>
            <groupfilter function='member' level='[none:Segment (rfm_transaction_dashboard.csv):nk]' member='&quot;Need Attention&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Segment:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Segment:nk]' member='&quot;About to Sleep&quot;' />
              <groupfilter function='member' level='[none:Segment:nk]' member='&quot;At Risk&quot;' />
              <groupfilter function='member' level='[none:Segment:nk]' member='&quot;Can&apos;t Loose&quot;' />
              <groupfilter function='member' level='[none:Segment:nk]' member='&quot;Champions&quot;' />
              <groupfilter function='member' level='[none:Segment:nk]' member='&quot;Hibernating&quot;' />
              <groupfilter function='member' level='[none:Segment:nk]' member='&quot;Loyal Customers&quot;' />
              <groupfilter function='member' level='[none:Segment:nk]' member='&quot;Need Attention&quot;' />
              <groupfilter function='member' level='[none:Segment:nk]' member='&quot;New Customers&quot;' />
              <groupfilter function='member' level='[none:Segment:nk]' member='&quot;Potential Loyalists&quot;' />
              <groupfilter function='member' level='[none:Segment:nk]' member='&quot;Promising&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Segment:nk]</column>
            <column>[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Segment (rfm_transaction_dashboard.csv):nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' value='1152' />
            <format attr='text-format' field='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[avg:Monetary:qk]' value='c&quot;£&quot;#,##0.0;-&quot;£&quot;#,##0.0' />
            <format attr='text-format' field='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[avg:Recency:qk]' value='n#,##0.0;-#,##0.0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Segment:nk]' />
              <text column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Calculation_4224289306980355:nk]' />
              <text column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[ctd:Customer ID:qk]' />
              <text column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[avg:Monetary:qk]' />
              <text column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[avg:Frequency:qk]' />
              <text column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[avg:Recency:qk]' />
              <text column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[usr:Calculation_4224289309868036:qk]' />
              <text column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Calculation_4224289312370693:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold='true' fontalignment='0' fontsize='20'><![CDATA[<[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Segment:nk]>]]></run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontcolor='#666666' fontsize='11'><![CDATA[<[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Calculation_4224289306980355:nk]>]]></run>
                <run fontalignment='0'>Æ&#10;&#10;</run>
                <run fontalignment='0' fontname='Benton Sans Book' fontsize='15'>👥 </run>
                <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='15'><![CDATA[<[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[ctd:Customer ID:qk]>      ]]></run>
                <run fontalignment='0' fontsize='20'>◉</run>
                <run bold='true' fontalignment='0' fontname='Benton Sans Book' fontsize='15'><![CDATA[<[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[usr:Calculation_4224289309868036:qk]>     💰 <[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[avg:Monetary:qk]>        🛒 <[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[avg:Frequency:qk]>      🕐 <[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[avg:Recency:qk]>]]></run>
                <run fontalignment='0' fontname='Benton Sans Book' fontsize='15'>Æ </run>
