              <color column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Segment:nk]' />
              <tooltip column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[attr:Calculation_4224289291464704:nk]' />
              <text column='[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[pcto:ctd:Customer ID:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontsize='12'><![CDATA[<[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[none:Segment:nk]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='9'><![CDATA[<[federated.1u4if6a1y9ozz51g54qpq0sfnp5q].[attr:Calculation_4224289291464704:nk]>]]></run>
                <run>Æ&#10;&#10;&#10;</run>
