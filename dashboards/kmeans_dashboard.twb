    <worksheet name='K-Means - Customer Insight'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#5e1c65' fontsize='14'>CUSTOMER INSIGHT</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rfm_customer_segmentation_kmeans.csv+ (Multiple Connections)' name='federated.02l1epl1dml5ru17wpx3b0uuk8qq' />
          </datasources>
          <datasource-dependencies datasource='federated.02l1epl1dml5ru17wpx3b0uuk8qq'>
            <column caption='Cluster Name' datatype='string' name='[Calculation_4224289702567949]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Cluster]&#10;WHEN 0 THEN &quot;High-Value Champions&quot;&#10;WHEN 1 THEN &quot;Low-Value Inactive&quot;&#10;WHEN 2 THEN &quot;Low-Value Recent&quot;&#10;WHEN 3 THEN &quot;At-Risk Customers&quot;&#10;WHEN 4 THEN &quot;Potential Loyalists&quot;&#10;END' />
            </column>
            <column caption='Cluster Description' datatype='string' name='[Calculation_4224289702854670]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Cluster]&#10;&#10;WHEN 0 THEN&#10;&quot;Highest-value customers with very recent, frequent, and high-value purchases.&quot;&#10;&#10;WHEN 1 THEN&#10;&quot;Inactive, low-value customers with infrequent purchases and long periods since their last purchase.&quot;&#10;&#10;WHEN 2 THEN&#10;&quot;Relatively recent customers with low purchase frequency and monetary value.&quot;&#10;&#10;WHEN 3 THEN&#10;&quot;Previously valuable customers whose purchasing activity has declined.&quot;&#10;&#10;WHEN 4 THEN&#10;&quot;Recent customers with moderate frequency and monetary value, showing strong potential for loyalty.&quot;&#10;&#10;END' />
            </column>
            <column caption='% of Customers' datatype='real' name='[Calculation_4224289704706065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Customer ID])&#10;/&#10;MIN({ FIXED : COUNTD([Customer ID]) })' />
            </column>
            <column datatype='integer' name='[Cluster]' role='measure' type='quantitative' />
            <column datatype='real' name='[Customer ID]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Frequency]' role='measure' type='quantitative' />
            <column datatype='real' name='[Monetary]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Recency]' role='measure' type='quantitative' />
            <column-instance column='[Frequency]' derivation='Avg' name='[avg:Frequency:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Monetary]' derivation='Avg' name='[avg:Monetary:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Recency]' derivation='Avg' name='[avg:Recency:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Customer ID]' derivation='CountD' name='[ctd:Customer ID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4224289702567949]' derivation='None' name='[none:Calculation_4224289702567949:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4224289702854670]' derivation='None' name='[none:Calculation_4224289702854670:nk]' pivot='key' type='nominal' />
            <column-instance column='[Cluster]' derivation='None' name='[none:Cluster:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_4224289704706065]' derivation='User' name='[usr:Calculation_4224289704706065:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.02l1epl1dml5ru17wpx3b0uuk8qq].[none:Cluster:ok]' filter-group='4'>
